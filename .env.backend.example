# Copy this file to .env.backend and replace every required blank value.
# Never commit .env.backend. Do not add real credentials, usernames, public IP
# addresses, or private infrastructure details to this example file.

# Django runtime
# Required secret; generate a unique value outside the repository.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# The legacy CORS middleware expects host:port entries without a URL scheme.
DJANGO_CORS_ORIGIN_WHITELIST=localhost:8282,127.0.0.1:8282

# PostgreSQL values used by the backend. The shared database name and
# credentials are resolved from the general .env file by Docker Compose.
POSTGRES_DB=${POSTGRES_DB:-conduit}
POSTGRES_USER=${POSTGRES_USER:?Set POSTGRES_USER in .env}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in .env}
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Backend startup and process configuration
DB_WAIT_TIMEOUT=60
GUNICORN_WORKERS=3
