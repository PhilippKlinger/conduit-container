# Copy this file to .env and replace every required blank value.
# Never commit .env. Do not add real credentials, usernames, public IP
# addresses, or private infrastructure details to this example file.

# Baseline image choices
NODE_IMAGE=node:20-alpine
NGINX_IMAGE=nginx:1.28.3-alpine
PYTHON_IMAGE=python:3.6-slim
POSTGRES_IMAGE=postgres:16.14-alpine

# Published ports
FRONTEND_PORT=8282
BACKEND_PORT=8000

# Frontend build-time configuration
# Required: public URL through which the browser reaches the backend API.
API_URL=

# Django runtime configuration
# Required secret; generate a unique value outside the repository.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Required for the target environment; do not place a private IP here in Git.
DJANGO_ALLOWED_HOSTS=
# django-cors-middleware 1.3.1 expects comma-separated host:port entries
# without http:// or https://.
DJANGO_CORS_ORIGIN_WHITELIST=

# PostgreSQL connection
POSTGRES_DB=conduit
# Authentication values intentionally have no examples or defaults.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend startup
DB_WAIT_TIMEOUT=60
GUNICORN_WORKERS=3
