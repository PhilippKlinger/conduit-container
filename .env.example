# Copy this file to .env and replace every required blank value.
# Never commit .env. Do not add real credentials, usernames, public IP
# addresses, or private infrastructure details to this example file.

# Baseline image choices
NODE_IMAGE=node:20-alpine
NGINX_IMAGE=nginx:1.28.3-alpine
PYTHON_IMAGE=python:3.6-slim
POSTGRES_IMAGE=postgres:16.14-alpine

# Deployment address
# Host or IP the browser uses to reach this deployment. Use localhost for a
# local run or the public address of your VM. Host or IP only, no scheme and
# no port. The API URL, ALLOWED_HOSTS and the CORS whitelist derive from it.
PUBLIC_HOST=localhost

# Published ports
FRONTEND_PORT=8282
BACKEND_PORT=8000

# Django runtime configuration
# Required secret; generate a unique value outside the repository.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# PostgreSQL connection
POSTGRES_DB=conduit
# Authentication values intentionally have no examples or defaults.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend startup
DB_WAIT_TIMEOUT=60
GUNICORN_WORKERS=3
