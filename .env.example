# Copy this file to .env and replace every required blank value.
# Never commit .env. Do not add real credentials, usernames, public IP
# addresses, or private infrastructure details to this example file.

# Baseline image choices
NODE_IMAGE=node:20-alpine
NGINX_IMAGE=nginx:1.28.3-alpine
PYTHON_IMAGE=python:3.6-slim
POSTGRES_IMAGE=postgres:16.14-alpine

# Browser-reachable API endpoint compiled into the Angular bundle
API_URL=http://localhost:8000/api

# Published ports
FRONTEND_PORT=8282
BACKEND_PORT=8000

# PostgreSQL values shared by the backend and database services
POSTGRES_DB=conduit
# Authentication values intentionally have no examples or defaults.
POSTGRES_USER=
POSTGRES_PASSWORD=
